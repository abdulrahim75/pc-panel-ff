<Window x:Class="HeadshotPanel.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:HeadshotPanel.Models"
 xmlns:views="clr-namespace:HeadshotPanel.Views"
 Title="HeadshotPanel"
 Width="1180" Height="760"
 MinWidth="900" MinHeight="620"
 WindowStartupLocation="CenterScreen"
 WindowStyle="None"
 ResizeMode="CanResize"
 Background="{StaticResource BackgroundColor}"
 AllowsTransparency="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource SidebarColor}" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentColor}">
                    <TextBlock Text="H" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="HEADSHOT PANEL" Foreground="{StaticResource PrimaryText}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="BETA" Foreground="{StaticResource AccentColor}" FontSize="9" FontWeight="Bold" Margin="9,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click"/>
                <Button Content="□" Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click"/>
                <Button Content="✕" Style="{StaticResource WindowButtonStyle}" Background="#B92636" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,1,0">
                <Grid Margin="18,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold" Margin="12,0,0,12"/>
                        <Button Content="▣   Dashboard" Style="{StaticResource NavigationButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.Dashboard}"/>
                        <Button Content="◎   Detection Lab" Style="{StaticResource NavigationButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.DetectionLab}"/>
                        <Button Content="⚙   Settings" Style="{StaticResource NavigationButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.Settings}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="SYSTEM" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold" Margin="12,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="12,4">
                            <Ellipse Width="7" Height="7" Fill="#4CAF80" Margin="0,0,9,0"/>
                            <TextBlock Text="Application Ready" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,4">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentColor}" Margin="0,0,9,0"/>
                            <TextBlock Text="Vision Engine Offline" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Margin="34,30" Content="{Binding CurrentView}"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
