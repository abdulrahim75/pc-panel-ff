<UserControl x:Class="HeadshotPanel.Views.DetectionLabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel>
            <TextBlock Text="Detection Lab" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Analyze prerecorded video without live-game integration." Style="{StaticResource PageDescriptionStyle}"/>
            <Border Style="{StaticResource ContentCardStyle}" MinHeight="430">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Video workspace" Style="{StaticResource SectionTitleStyle}"/>
                    <Border Grid.Row="1" Margin="0,20" Background="#111117" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8">
                        <Grid Margin="26">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                            <TextBlock Text="{Binding VideoPath, TargetNullValue='NO VIDEO LOADED'}"
                                       Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Select private or prerecorded footage only."
                                       Foreground="{StaticResource SecondaryText}" Margin="0,8,0,20"/>
                            <TextBlock Text="YOLO model" Foreground="{StaticResource SecondaryText}" FontSize="11"/>
                            <TextBlock Text="{Binding ModelPath, TargetNullValue='No local model selected'}"
                                       Foreground="{StaticResource PrimaryText}" Margin="0,5,0,16"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Engine status:" Foreground="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding EngineStatus}" Foreground="{StaticResource AccentColor}" FontWeight="Bold" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ProcessError}" Foreground="#FF3045" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="1" Margin="0,18,0,0" Background="#09090D" CornerRadius="8" MinHeight="210">
                                <Grid>
                                    <Image Source="{Binding PreviewFrame}" Stretch="Uniform"/>
                                    <TextBlock Text="Waiting for prerecorded video frames"
                                               Foreground="{StaticResource SecondaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewFrame}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="SELECT VIDEO" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SelectVideoCommand}"/>
                        <Button Content="SELECT MODEL" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Command="{Binding SelectModelCommand}"/>
                        <Button Content="START ANALYSIS" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Command="{Binding StartEngineCommand}"/>
                        <Button Content="STOP" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Command="{Binding StopEngineCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
